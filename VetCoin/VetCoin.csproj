<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
		<!-- Blazor WASM のデバッグ用プロキシ(約12MB)は本番に不要 -->
		<BlazorWebAssemblyOmitDebugProxyOutput Condition="'$(Configuration)' == 'Release'">true</BlazorWebAssemblyOmitDebugProxyOutput>
		<UserSecretsId>VetCoin-98CB18F9-7DB3-425A-BB88-00D9D82DAE7C</UserSecretsId>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="19.0.0" />
		<PackageReference Include="Discord.Net" Version="2.2.0" />
		<!-- Discord.Net 2.x が推移的に引く System.Linq.Async は .NET 10 の System.Linq.AsyncEnumerable と衝突するため、コンパイル時のみ除外(実行時は Discord.Net が使う) -->
		<PackageReference Include="System.Linq.Async" Version="4.0.0" ExcludeAssets="compile" />
		<PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.17.1" />
		<PackageReference Include="MarkdownSharp" Version="2.0.5" />
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="ncrontab" Version="3.3.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.12" />
	</ItemGroup>

	<!-- scaffolding 用の設計時パッケージ。実行時には使わないので Debug のみ参照(Release の publish に Roslyn/MSBuild を持ち込まない) -->
	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Migrations\" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="Templates\RazorPageGenerator\Create.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\CreatePageModel.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\Delete.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\DeletePageModel.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\Details.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\DetailsPageModel.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\Edit.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\EditPageModel.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\Empty.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\EmptyPageModel.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\List.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\ListPageModel.cshtml" />
		<Content Remove="Templates\RazorPageGenerator\_ValidationScriptsPartial.cshtml" />
	</ItemGroup>
	<ItemGroup>
		<None Include="Pages\Shared\DisplayTemplates\DateTimeOffset.cshtml" />
		<None Include="Templates\RazorPageGenerator\Create.cshtml" />
		<None Include="Templates\RazorPageGenerator\CreatePageModel.cshtml" />
		<None Include="Templates\RazorPageGenerator\Delete.cshtml" />
		<None Include="Templates\RazorPageGenerator\DeletePageModel.cshtml" />
		<None Include="Templates\RazorPageGenerator\Details.cshtml" />
		<None Include="Templates\RazorPageGenerator\DetailsPageModel.cshtml" />
		<None Include="Templates\RazorPageGenerator\Edit.cshtml" />
		<None Include="Templates\RazorPageGenerator\EditPageModel.cshtml" />
		<None Include="Templates\RazorPageGenerator\Empty.cshtml" />
		<None Include="Templates\RazorPageGenerator\EmptyPageModel.cshtml" />
		<None Include="Templates\RazorPageGenerator\List.cshtml" />
		<None Include="Templates\RazorPageGenerator\ListPageModel.cshtml" />
		<None Include="Templates\RazorPageGenerator\_ValidationScriptsPartial.cshtml" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\VetCoinWasm\VetCoinWasm.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- 送金画像用フォント(Comic Neue・SIL OFL 1.1)。Linux の App Service に Comic Sans は無いため同梱してパス指定する -->
		<None Update="Fonts\ComicNeue-Regular.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Update="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Microsoft.Data.SqlClient が推移的に引く MSAL ブローカー(WAM)の native(libmsalruntime 約37MB)は、SQL 認証では使わないので publish から外す -->
	<Target Name="RemoveMsalBrokerNativeFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'libmsalruntime.so' Or '%(Filename)%(Extension)' == 'msalruntime.dll' Or '%(Filename)%(Extension)' == 'msalruntime_x86.dll' Or '%(Filename)%(Extension)' == 'msalruntime_arm64.dll' Or '%(Filename)%(Extension)' == 'libmsalruntime.dylib'" />
		</ItemGroup>
	</Target>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties appsettings_1json__JsonSchema="" properties_4launchsettings_1json__JsonSchema="" />
		</VisualStudio>
	</ProjectExtensions>

</Project>
